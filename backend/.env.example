# ==========================================
# File cấu hình mẫu MuMuAINovel
# ==========================================
# Copy file này thành .env và sửa giá trị cấu hình
# cp .env.example .env

# ==========================================
# Cấu hình ứng dụng
# ==========================================
APP_NAME=MuMuAINovel
APP_VERSION=1.5.6
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# ==========================================
# Cấu hình database PostgreSQL
# ==========================================

# Thông tin kết nối PostgreSQL
POSTGRES_DB=mumuai_novel
POSTGRES_USER=mumuai
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# URL kết nối database (tự sinh khi triển khai Docker)
# DATABASE_URL=postgresql+asyncpg://mumuai:123456@localhost:5432/mumuai_novel

# ==========================================
# Cấu hình database SQLite
# ==========================================

# DATABASE_URL=sqlite+aiosqlite:///data/ai_story.db

# ==========================================
# Cấu hình log
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ==========================================
# Cấu hình CORS
# ==========================================
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ==========================================
# Cấu hình proxy toàn cục (tùy chọn, ảnh hưởng request mạng tuân theo biến môi trường)
# ==========================================
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# Cấu hình dịch vụ AI (cấu hình ít nhất một)
# ==========================================

# Cấu hình OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Bộ chuyển đổi tích hợp Xiaomi MiMo (định dạng tương thích OpenAI)
# Chú ý: đừng commit Key thật vào repo code; chỉ cấu hình trong .env cục bộ hoặc biến môi trường triển khai
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Cấu hình AI mặc định
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000

# LLM nội mạng cục bộ / Docker (Ollama, llama.cpp, host.docker.internal)
# Mặc định tắt, giữ bảo vệ SSRF. Chỉ bật khi triển khai trên máy mình hoặc mạng tin cậy.
# ALLOW_PRIVATE_AI_ENDPOINTS=true
# ALLOWED_AI_HOSTS=host.docker.internal,127.0.0.1

# ==========================================
# Cấu hình LinuxDO OAuth (tùy chọn)
# ==========================================
LINUXDO_CLIENT_ID=11111
LINUXDO_CLIENT_SECRET=11111
LINUXDO_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Proxy riêng cho đăng nhập LinuxDO (tùy chọn, chỉ ảnh hưởng request OAuth token và thông tin người dùng, không ảnh hưởng AI/SMTP/request khác)
# LINUXDO_PROXY_URL=http://127.0.0.1:7890
FRONTEND_URL=http://localhost:8000

# Quản trị viên ban đầu (LinuxDO user_id)
# INITIAL_ADMIN_LINUXDO_ID=your_linuxdo_user_id

# ==========================================
# Cấu hình đăng nhập tài khoản cục bộ
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin123
LOCAL_AUTH_DISPLAY_NAME=Quản trị viên cục bộ

# ==========================================
# Cấu hình session
# ==========================================
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30
# Cookie session có bắt buộc Secure không: để trống tự phán đoán theo DEBUG; triển khai HTTP có thể đặt false
# SESSION_COOKIE_SECURE=false

# ==========================================
# Cấu hình SMTP mặc định (quản trị viên có thể ghi đè trong cài đặt hệ thống)
# ==========================================
SMTP_PROVIDER=qq
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-qq-smtp-auth-code
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_FROM_NAME=MuMuAINovel
EMAIL_AUTH_ENABLED=true
EMAIL_REGISTER_ENABLED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60

# ==========================================
# Cấu hình xưởng prompt
# ==========================================
# Chế độ chạy: client (triển khai cục bộ) hoặc server (máy chủ đám mây)
# Chỉ mumuverse.space:1566 cần đặt thành server
WORKSHOP_MODE=client

# Địa chỉ dịch vụ đám mây (chế độ client dùng)
WORKSHOP_CLOUD_URL=https://mumuverse.space:1566

# Thời gian timeout request API đám mây (giây)
WORKSHOP_API_TIMEOUT=30
